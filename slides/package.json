{
  "name": "czechitas-ai-data-slides",
  "private": true,
  "scripts": {
    "dev": "slidev",
    "build": "slidev build --base /czechitas-ai-data/ --out ../dist",
    "preview": "npm run build && npx serve ../dist -l 4000",
    "export": "slidev export --output export/ai-v-datove-analyze.pdf && slidev export --format pptx --output export/ai-v-datove-analyze.pptx"
  },
  "dependencies": {
    "@slidev/cli": "^52.12.0",
    "@slidev/theme-default": "^0.25.0"
  },
  "devDependencies": {
    "playwright-chromium": "^1.58.2"
  }
}
